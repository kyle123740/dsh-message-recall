{
  "name": "dsh-message-recall",
  "version": "0.1.6",
  "description": "每条消息都能撤回 / 删除（含「删除此处及之后」）的 DeepSeek Harness 插件：写 append-only 墓碑，模型上下文与界面同步移除。Per-message recall / delete for DeepSeek Harness sessions.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/main.js",
  "exports": {
    ".": "./lib/main.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "message",
    "recall",
    "delete",
    "撤回",
    "删除"
  ],
  "author": "kyle123740",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyle123740/dsh-message-recall.git"
  },
  "bugs": {
    "url": "https://github.com/kyle123740/dsh-message-recall/issues"
  },
  "homepage": "https://github.com/kyle123740/dsh-message-recall#readme",
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.7-alpha.1"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": ">=0.1.7-alpha.1"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "verify:client": "node scripts/verify-client.mjs",
    "test": "node scripts/verify.mjs && node scripts/verify-persistence.mjs && node scripts/verify-client.mjs",
    "verify:persistence": "node scripts/verify-persistence.mjs"
  }
}
